<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.catalogodigital.system.controller.LoginController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label text="Iniciar Sesion" />
        <TextField fx:id="txtCorreo" promptText="Correo electronico" />
        <PasswordField fx:id="txtContrasena" promptText="Contrasena" />
        <ComboBox fx:id="cbRol" promptText="Seleccione su rol" />
        <Button fx:id="btnIniciarSesion" onAction="#handleLogin" text="Iniciar Sesion" />
        <Hyperlink fx:id="hlRegistro" onAction="#handleIrARegistro" text="¿No has registrado tu correo?" />
    </children>
</VBox>