<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="600.0" prefWidth="800.0" spacing="15.0" styleClass="root" stylesheets="@/org/library/system/resources/styles/StylesLibrary.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.library.system.controller.PrestamoController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label styleClass="titulo-principal" text="Registrar Prestamo" />
        <Label styleClass="subtitulo" text="Datos del Estudiante" />
        <HBox spacing="10.0">
            <children>
                <TextField fx:id="txtCarnet" promptText="Carnet" prefWidth="200" styleClass="campo-texto" />
                <Button fx:id="btnBuscarEstudiante" onAction="#handleBuscarEstudiante" styleClass="btn-primary" text="Buscar" />
            </children>
        </HBox>
        <Label fx:id="lblNombre" styleClass="etiqueta-informacion" text="Nombre: -" />
        <Label styleClass="subtitulo" text="Datos del Libro" />
        <HBox spacing="10.0">
            <children>
                <TextField fx:id="txtISBN" promptText="ISBN" prefWidth="200" styleClass="campo-texto" />
                <Button fx:id="btnBuscarLibro" onAction="#handleBuscarLibro" styleClass="btn-primary" text="Buscar" />
            </children>
        </HBox>
        <Label fx:id="lblTitulo" styleClass="etiqueta-informacion" text="Titulo: -" />
        <Label styleClass="subtitulo" text="Fechas" />
        <Label fx:id="lblFechaPrestamo" styleClass="etiqueta-informacion" text="Fecha Prestamo: -" />
        <Label fx:id="lblFechaLimite" styleClass="etiqueta-informacion" text="Fecha Limite: -" />
        <HBox spacing="10.0">
            <children>
                <Button fx:id="btnGenerarPrestamo" onAction="#handleGenerarPrestamo" styleClass="btn-primary" text="Generar Prestamo" />
                <Button fx:id="btnImprimir" onAction="#handleImprimir" styleClass="btn-primary" text="Imprimir Comprobante" />
                <Button fx:id="btnRegresar" onAction="#handleRegresar" styleClass="btn-secondary" text="Regresar" />
            </children>
        </HBox>
    </children>
</VBox>