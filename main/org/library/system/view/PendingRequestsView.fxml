<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="600.0" prefWidth="1000.0" spacing="10.0" styleClass="root" stylesheets="@../resources/styles/StylesLibrary.css" xmlns="http://javafx.com/javafx/23.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.library.system.controller.PendingRequestsController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label styleClass="label-title" text="Solicitudes de Prestamo Pendientes" />

        <TableView fx:id="tableRequests" prefHeight="450.0">
            <columns>
                <TableColumn fx:id="colRequestId" prefWidth="60" text="ID" />
                <TableColumn fx:id="colStudentCode" prefWidth="150" text="Carnet" />
                <TableColumn fx:id="colStudentName" prefWidth="250" text="Estudiante" />
                <TableColumn fx:id="colRequestDate" prefWidth="180" text="Fecha Solicitud" />
                <TableColumn fx:id="colStatus" prefWidth="120" text="Estado" />
            </columns>
        </TableView>

        <HBox spacing="10.0">
            <children>
                <Button fx:id="btnApprove" onAction="#handleApprove" prefHeight="36.0" prefWidth="159.0" text="Aprobar" />
                <Button fx:id="btnReject" onAction="#handleReject" prefHeight="36.0" prefWidth="147.0" styleClass="button-danger" text="Rechazar" />
                <Button fx:id="btnRefresh" onAction="#handleRefresh" prefHeight="36.0" prefWidth="145.0" styleClass="button-secondary" text="Actualizar" />
                <Button fx:id="btnBack" onAction="#handleBack" prefHeight="36.0" prefWidth="146.0" styleClass="button-back" text="Regresar" />
            </children>
        </HBox>
    </children>
</VBox>
