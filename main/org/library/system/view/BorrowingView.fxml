<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" styleClass="root" stylesheets="@../resources/styles/StylesLibrary.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.library.system.controller.BorrowingController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label styleClass="titulo-principal" text="Registrar Prestamo" />

        <Label styleClass="subtitulo" text="Datos del Estudiante" />
        <HBox spacing="10.0">
            <children>
                <TextField fx:id="txtStudentId" promptText="Carnet" prefWidth="200" styleClass="campo-texto" />
                <Button fx:id="btnSearchStudent" onAction="#handleSearchStudent" styleClass="btn-primary" text="Buscar" />
            </children>
        </HBox>
        <Label fx:id="lblStudentName" styleClass="etiqueta-informacion" text="Nombre: -" />
        <Label fx:id="lblStudentEmail" styleClass="etiqueta-informacion" text="Correo: -" />

        <Label styleClass="subtitulo" text="Datos del Libro / Ejemplar" />
        <HBox spacing="10.0">
            <children>
                <TextField fx:id="txtIsbn" promptText="ISBN" prefWidth="150" styleClass="campo-texto" />
                <TextField fx:id="txtBookTitle" promptText="Titulo" prefWidth="200" styleClass="campo-texto" />
                <Button fx:id="btnSearchBook" onAction="#handleSearchBook" styleClass="btn-primary" text="Buscar" />
            </children>
        </HBox>

        <TableView fx:id="tableCopies" prefHeight="200.0">
            <columns>
                <TableColumn fx:id="colBarcode" text="Codigo de Barras" prefWidth="150" />
                <TableColumn fx:id="colStatus" text="Estado" prefWidth="100" />
                <TableColumn fx:id="colSelect" text="Seleccionar" prefWidth="100" />
            </columns>
        </TableView>

        <Label styleClass="subtitulo" text="Fechas" />
        <HBox spacing="20.0">
            <children>
                <VBox spacing="5.0">
                    <children>
                        <Label text="Fecha de Prestamo:" />
                        <Label fx:id="lblBorrowDate" styleClass="etiqueta-informacion" text="Fecha actual" />
                    </children>
                </VBox>
                <VBox spacing="5.0">
                    <children>
                        <Label text="Fecha Limite (Devolucion):" />
                        <DatePicker fx:id="dpDueDate" promptText="Seleccione fecha" />
                    </children>
                </VBox>
            </children>
        </HBox>

        <HBox spacing="10.0">
            <children>
                <Button fx:id="btnGenerateBorrowing" onAction="#handleGenerateBorrowing" styleClass="btn-primary" text="Generar Prestamo" />
                <Button fx:id="btnPrintReceipt" onAction="#handlePrintReceipt" styleClass="btn-primary" text="Imprimir Comprobante" />
                <Button fx:id="btnBack" onAction="#handleBack" styleClass="btn-secondary" text="Regresar" />
            </children>
        </HBox>
    </children>
</VBox>