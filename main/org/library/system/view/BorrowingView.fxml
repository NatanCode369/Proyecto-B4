<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="700.0" prefWidth="1000.0" spacing="12.0" styleClass="root" stylesheets="@../resources/styles/StylesLibrary.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.library.system.controller.BorrowingController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label styleClass="label-title" text="Registrar Prestamo" />

        <Label text="Datos del Estudiante" />
        <HBox spacing="10.0">
            <children>
                <TextField fx:id="txtStudentId" promptText="Carnet del estudiante" prefWidth="250" styleClass="text-field" />
                <Button fx:id="btnSearchStudent" onAction="#handleSearchStudent" text="Buscar Estudiante" />
            </children>
        </HBox>
        <Label fx:id="lblStudentName" text="Nombre: -" />
        <Label fx:id="lblStudentEmail" text="Correo: -" />

        <Label text="Datos del Libro" />
        <HBox spacing="10.0">
            <children>
                <TextField fx:id="txtIsbn" promptText="ISBN" prefWidth="180" styleClass="text-field" />
                <TextField fx:id="txtBookTitle" promptText="Titulo" prefWidth="250" styleClass="text-field" />
                <Button fx:id="btnSearchBook" onAction="#handleSearchBook" text="Buscar Libro" />
            </children>
        </HBox>

        <TableView fx:id="tableBooks" prefHeight="250.0">
            <columns>
                <TableColumn fx:id="colIsbn" text="ISBN" prefWidth="150" />
                <TableColumn fx:id="colTitle" text="Titulo" prefWidth="250" />
                <TableColumn fx:id="colAuthor" text="Autor" prefWidth="180" />
                <TableColumn fx:id="colAvailable" text="Disponibles" prefWidth="100" />
            </columns>
        </TableView>

        <Label text="Fecha Limite de Devolucion" />
        <HBox spacing="20.0">
            <children>
                <Label text="Fecha de Prestamo:" />
                <Label fx:id="lblBorrowDate" text="-" />
                <Label text="     Fecha Limite:" />
                <DatePicker fx:id="dpDueDate" promptText="Seleccione fecha" />
            </children>
        </HBox>

        <HBox spacing="10.0">
            <children>
                <Button fx:id="btnGenerateBorrowing" onAction="#handleGenerateBorrowing" text="Generar Prestamo" />
                <Button fx:id="btnPrintReceipt" onAction="#handlePrintReceipt" styleClass="button-secondary" text="Imprimir Comprobante" />
                <Button fx:id="btnBack" onAction="#handleBack" styleClass="button-back" text="Regresar" />
            </children>
        </HBox>
    </children>
</VBox>