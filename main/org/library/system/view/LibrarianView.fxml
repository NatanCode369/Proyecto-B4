<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="700.0" prefWidth="1100.0" spacing="10.0" styleClass="root" stylesheets="@../resources/styles/StylesLibrary.css" xmlns="http://javafx.com/javafx/23.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.library.system.controller.LibrarianController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label styleClass="label-title" text="Gestion de Bibliotecarios" />

        <!-- BUSQUEDA -->
        <HBox spacing="10.0">
            <children>
                <TextField fx:id="txtSearch" promptText="Buscar por codigo, nombre o correo" prefWidth="400" styleClass="text-field" />
                <Button fx:id="btnSearch" onAction="#handleSearch" text="Buscar" />
                <Button fx:id="btnClearSearch" onAction="#handleClearSearch" styleClass="button-secondary" text="Limpiar busqueda" />
            </children>
        </HBox>

        <!-- FORMULARIO -->
        <Label text="Datos del Bibliotecario" />
        <HBox spacing="10.0">
            <children>
                <TextField fx:id="txtUserCode" promptText="Codigo (ej: BIB001)" prefWidth="150" styleClass="text-field" />
                <TextField fx:id="txtFirstName" promptText="Nombre" prefWidth="180" styleClass="text-field" />
                <TextField fx:id="txtLastName" promptText="Apellido" prefWidth="180" styleClass="text-field" />
            </children>
        </HBox>
        <HBox spacing="10.0">
            <children>
                <TextField fx:id="txtEmail" promptText="Correo electronico" prefWidth="280" styleClass="text-field" />
                <TextField fx:id="txtPassword" promptText="Contrasena" prefWidth="200" styleClass="text-field" />
                <CheckBox fx:id="chkActive" text="Activo" selected="true" />
            </children>
        </HBox>
        <HBox spacing="10.0">
            <children>
                <Button fx:id="btnAdd" onAction="#handleAdd" text="Agregar" />
                <Button fx:id="btnUpdate" onAction="#handleUpdate" styleClass="button-secondary" text="Actualizar" />
                <Button fx:id="btnDelete" onAction="#handleDelete" styleClass="button-danger" text="Eliminar" />
                <Button fx:id="btnClearFields" onAction="#handleClearFields" styleClass="button-secondary" text="Limpiar campos" />
            </children>
        </HBox>

        <!-- TABLA -->
        <TableView fx:id="tableLibrarians" prefHeight="350.0">
            <columns>
                <TableColumn fx:id="colUserId" text="ID" prefWidth="60" />
                <TableColumn fx:id="colUserCode" text="Codigo" prefWidth="120" />
                <TableColumn fx:id="colFirstName" text="Nombre" prefWidth="150" />
                <TableColumn fx:id="colLastName" text="Apellido" prefWidth="150" />
                <TableColumn fx:id="colEmail" text="Correo" prefWidth="250" />
                <TableColumn fx:id="colRole" text="Rol" prefWidth="120" />
                <TableColumn fx:id="colActive" text="Activo" prefWidth="80" />
            </columns>
        </TableView>

        <Button fx:id="btnBack" onAction="#handleBack" styleClass="button-back" text="Regresar" />
    </children>
</VBox>