<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="600.0" prefWidth="1000.0" spacing="10.0" styleClass="root" stylesheets="@../resources/styles/StylesLibrary.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.library.system.controller.CatalogController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label styleClass="titulo-principal" text="Catalogo de Libros" />
        <HBox spacing="10.0">
            <children>
                <TextField fx:id="txtIsbn" promptText="ISBN" prefWidth="150" styleClass="campo-texto" />
                <TextField fx:id="txtTitle" promptText="Titulo" prefWidth="200" styleClass="campo-texto" />
                <TextField fx:id="txtAuthor" promptText="Autor" prefWidth="150" styleClass="campo-texto" />
            </children>
        </HBox>
        <HBox spacing="10.0">
            <children>
                <TextField fx:id="txtPublisher" promptText="Editorial" prefWidth="150" styleClass="campo-texto" />
                <TextField fx:id="txtYear" promptText="Anio" prefWidth="100" styleClass="campo-texto" />
                <TextField fx:id="txtCopies" promptText="Copias" prefWidth="100" styleClass="campo-texto" />
            </children>
        </HBox>
        <HBox spacing="10.0">
            <children>
                <Button fx:id="btnAdd" onAction="#handleAddBook" styleClass="btn-primary" text="Agregar" />
                <Button fx:id="btnClear" onAction="#handleClearFields" styleClass="btn-secondary" text="Limpiar" />
                <Button fx:id="btnNewBorrowing" onAction="#handleNewBorrowing" styleClass="btn-primary" text="Nuevo Prestamo" />
            </children>
        </HBox>
        <TableView fx:id="tableBooks" prefHeight="300.0">
            <columns>
                <TableColumn fx:id="colIsbn" text="ISBN" prefWidth="150" />
                <TableColumn fx:id="colTitle" text="Titulo" prefWidth="200" />
                <TableColumn fx:id="colAuthor" text="Autor" prefWidth="150" />
                <TableColumn fx:id="colPublisher" text="Editorial" prefWidth="150" />
                <TableColumn fx:id="colYear" text="Anio" prefWidth="80" />
                <TableColumn fx:id="colCopies" text="Copias" prefWidth="80" />
            </columns>
        </TableView>
        <Button fx:id="btnBack" onAction="#handleBack" styleClass="btn-secondary" text="Regresar" />
    </children>
</VBox>