                        </Label>
                        <Label text="Comprobante de Préstamo" textFill="#7f8c8d">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Label>
                    </children>
                </HBox>

                <!-- Datos del Estudiante -->
                <VBox spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
                    <children>
                        <Label text="👤 Datos del Estudiante" textFill="#34495e">
                            <font>
                                <Font name="System Bold" size="16.0" />
                            </font>
                        </Label>

                        <HBox spacing="20.0">
                            <children>
                                <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <HBox spacing="10.0">
                                            <children>
                                                <Label minWidth="70.0" text="Carnet:" textFill="#34495e" />
                                                <TextField fx:id="txtCarnet" promptText="Ingrese el carnet" style="-fx-background-radius: 5; -fx-border-color: #bdc3c7; -fx-border-radius: 5;" HBox.hgrow="ALWAYS" />
                                            </children>
                                        </HBox>
                                        <HBox spacing="10.0">
                                            <children>
                                                <Label minWidth="70.0" text="Nombre:" textFill="#34495e" />
                                                <Label fx:id="lblNombre" style="-fx-background-color: #f8f9fa; -fx-background-radius: 5; -fx-padding: 8;" text="-" textFill="#2c3e50" HBox.hgrow="ALWAYS" />
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                                <VBox alignment="BOTTOM_RIGHT" spacing="10.0">
                                    <children>
                                        <Button fx:id="btnBuscarEstudiante" onAction="#handleBuscarEstudiante" style="-fx-background-color: #3498db; -fx-background-radius: 5; -fx-text-fill: white; -fx-font-weight: bold;" text="🔍 Buscar" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <!-- Datos del Libro -->
                <VBox spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
                    <children>
                        <Label text="📚 Datos del Libro" textFill="#34495e">
                            <font>
                                <Font name="System Bold" size="16.0" />
                            </font>
                        </Label>

                        <HBox spacing="20.0">
                            <children>
                                <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <HBox spacing="10.0">
                                            <children>
                                                <Label minWidth="70.0" text="ISBN:" textFill="#34495e" />
                                                <TextField fx:id="txtISBN" promptText="Ingrese el ISBN" style="-fx-background-radius: 5; -fx-border-color: #bdc3c7; -fx-border-radius: 5;" HBox.hgrow="ALWAYS" />
                                            </children>
                                        </HBox>
                                        <HBox spacing="10.0">
                                            <children>
                                                <Label minWidth="70.0" text="Título:" textFill="#34495e" />
                                                <Label fx:id="lblTitulo" style="-fx-background-color: #f8f9fa; -fx-background-radius: 5; -fx-padding: 8;" text="-" textFill="#2c3e50" HBox.hgrow="ALWAYS" />
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                                <VBox alignment="BOTTOM_RIGHT" spacing="10.0">
                                    <children>
                                        <Button fx:id="btnBuscarLibro" onAction="#handleBuscarLibro" style="-fx-background-color: #3498db; -fx-background-radius: 5; -fx-text-fill: white; -fx-font-weight: bold;" text="🔍 Buscar" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <!-- Fechas -->
                <VBox spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
                    <children>
                        <Label text="📅 Fechas del Préstamo" textFill="#34495e">
