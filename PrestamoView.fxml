                        </Button>
                        <Button fx:id="btnGenerarPrestamo" onAction="#handleGenerarPrestamo" style="-fx-background-color: #27ae60; -fx-background-radius: 5; -fx-text-fill: white; -fx-font-weight: bold;" text="✅ Generar Préstamo">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Button>
