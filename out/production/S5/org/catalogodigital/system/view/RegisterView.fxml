<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.catalogodigital.system.controller.RegisterController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label text="Registro de Bibliotecario Jefe" />
        <TextField fx:id="txtNombre" promptText="Nombre completo" />
        <TextField fx:id="txtCorreo" promptText="Correo electronico" />
        <PasswordField fx:id="txtContrasena" promptText="Contrasena" />
        <PasswordField fx:id="txtConfirmarContrasena" promptText="Confirmar contrasena" />
        <HBox spacing="10.0">
            <children>
                <Button fx:id="btnRegistrar" onAction="#handleRegistrar" text="Registrar" />
                <Button fx:id="btnCancelar" onAction="#handleCancelar" text="Cancelar" />
            </children>
        </HBox>
    </children>
</VBox>