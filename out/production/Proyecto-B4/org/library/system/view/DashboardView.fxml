<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="600.0" prefWidth="980.0" spacing="20.0" styleClass="root" stylesheets="@../resources/styles/StylesLibrary.css" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.library.system.controller.DashboardController">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>
    <children>
        <Label fx:id="lblWelcome" styleClass="label-title" text="Bienvenido" />
        <Label fx:id="lblRole" text="Rol: " />

        <HBox prefHeight="498.0" prefWidth="920.0" spacing="20.0">
            <children>
                <Button fx:id="btnCatalog" onAction="#handleOpenCatalog" prefHeight="405.0" prefWidth="131.0" text="Catálogo Gest." />
                <Button fx:id="btnBorrowings" onAction="#handleOpenBorrowings" prefHeight="395.0" prefWidth="134.0" text="Prestamo Gest." />
                <Button fx:id="btnPendingRequests" onAction="#handlePendingRequests" prefHeight="439.0" prefWidth="134.0" text="Solicitudes" />
                <Button fx:id="btnManageLibrarians" onAction="#handleManageLibrarians" prefHeight="440.0" prefWidth="134.0" text="Bibliotecarios" />
                <Button fx:id="btnConsultCatalog" onAction="#handleConsultCatalog" prefHeight="415.0" prefWidth="134.0" styleClass="button-secondary" text="Catálogo" />
                <Button fx:id="btnMyBorrowings" onAction="#handleMyBorrowings" prefHeight="417.0" prefWidth="134.0" styleClass="button-secondary" text="Mis Prestamos" />
            </children>
        </HBox>
      <HBox prefHeight="100.0" prefWidth="200.0" />

              <Button fx:id="btnLogout" onAction="#handleLogout" prefHeight="36.0" prefWidth="304.0" styleClass="button-danger" text="Cerrar Sesion" />
    </children>
</VBox>
