<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="700.0" prefWidth="1100.0" spacing="10.0" styleClass="root" stylesheets="@../resources/styles/StylesLibrary.css" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.library.system.controller.LibrarianController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label styleClass="label-title" text="Gestion de Bibliotecarios" />

        <HBox spacing="10.0">
            <children>
                <TextField fx:id="txtSearch" prefHeight="36.0" prefWidth="272.0" promptText="Buscar por código, nombre o correo" styleClass="text-field" />
                <Button fx:id="btnSearch" onAction="#handleSearch" text="Buscar" />
                <Button fx:id="btnClearSearch" onAction="#handleClearSearch" styleClass="button-secondary" text="Limpiar busqueda" />
            </children>
        </HBox>

        <VBox fx:id="editSection" spacing="10.0">
            <children>
                <Label text="Datos del Bibliotecario" />
                <HBox spacing="10.0">
                    <children>
                        <TextField fx:id="txtUserCode" prefHeight="36.0" prefWidth="145.0" promptText="Código" styleClass="text-field" />
                        <TextField fx:id="txtFirstName" prefWidth="180" promptText="Nombre" styleClass="text-field" />
                        <TextField fx:id="txtLastName" prefHeight="36.0" prefWidth="178.0" promptText="Apellido" styleClass="text-field" />
                    </children>
                </HBox>
                <HBox spacing="10.0">
                    <children>
                        <TextField fx:id="txtEmail" prefHeight="36.0" prefWidth="254.0" promptText="Correo electronico" styleClass="text-field" />
                        <TextField fx:id="txtPassword" prefHeight="36.0" prefWidth="260.0" promptText="Contraseña" styleClass="text-field" />
                        <CheckBox fx:id="chkActive" selected="true" text="Activo" />
                    </children>
                </HBox>
                <HBox spacing="10.0">
                    <children>
                        <Button fx:id="btnAdd" onAction="#handleAdd" prefHeight="36.0" prefWidth="141.0" text="Agregar" />
                        <Button fx:id="btnDelete" onAction="#handleDelete" prefHeight="36.0" prefWidth="103.0" styleClass="button-danger" text="Eliminar" />
                        <Button fx:id="btnUpdate" onAction="#handleUpdate" styleClass="button-secondary" text="Actualizar" />
                        <Button fx:id="btnClearFields" onAction="#handleClearFields" prefHeight="36.0" prefWidth="148.0" styleClass="button-secondary" text="Limpiar campos" />
                    </children>
                </HBox>
            </children>
        </VBox>

        <TableView fx:id="tableLibrarians" prefHeight="350.0">
            <columns>
                <TableColumn fx:id="colUserId" prefWidth="60" text="ID" />
                <TableColumn fx:id="colUserCode" prefWidth="120" text="Código" />
                <TableColumn fx:id="colFirstName" prefWidth="150" text="Nombre" />
                <TableColumn fx:id="colLastName" prefWidth="150" text="Apellido" />
                <TableColumn fx:id="colEmail" prefWidth="250" text="Correo" />
                <TableColumn fx:id="colRole" prefWidth="120" text="Rol" />
                <TableColumn fx:id="colActive" prefWidth="80" text="Activo" />
            </columns>
        </TableView>

        <Button fx:id="btnBack" onAction="#handleBack" prefHeight="36.0" prefWidth="173.0" styleClass="button-back" text="Regresar" />
    </children>
</VBox>
