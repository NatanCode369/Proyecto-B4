<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="700.0" prefWidth="1100.0" spacing="10.0" styleClass="root" stylesheets="@../resources/styles/StylesLibrary.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.library.system.controller.CatalogController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label styleClass="label-title" text="Catalogo de Libros" />

        <HBox spacing="10.0">
            <children>
                <TextField fx:id="txtSearchTitle" promptText="Buscar por titulo" prefWidth="300" styleClass="text-field" />
                <TextField fx:id="txtSearchIsbn" promptText="Buscar por ISBN" prefWidth="200" styleClass="text-field" />
                <Button fx:id="btnSearch" onAction="#handleSearch" text="Buscar" />
                <Button fx:id="btnClearSearch" onAction="#handleClearSearch" styleClass="button-secondary" text="Limpiar busqueda" />
            </children>
        </HBox>

        <VBox fx:id="editSection" spacing="10.0">
            <children>
                <Label text="Registrar nuevo libro" />
                <HBox spacing="10.0">
                    <children>
                        <TextField fx:id="txtIsbn" promptText="ISBN" prefWidth="150" styleClass="text-field" />
                        <TextField fx:id="txtTitle" promptText="Titulo" prefWidth="200" styleClass="text-field" />
                        <TextField fx:id="txtAuthor" promptText="Autor" prefWidth="150" styleClass="text-field" />
                    </children>
                </HBox>
                <HBox spacing="10.0">
                    <children>
                        <TextField fx:id="txtPublisher" promptText="Editorial" prefWidth="150" styleClass="text-field" />
                        <TextField fx:id="txtYear" promptText="Anio" prefWidth="100" styleClass="text-field" />
                        <TextField fx:id="txtCopies" promptText="Copias" prefWidth="100" styleClass="text-field" />
                    </children>
                </HBox>
                <HBox spacing="10.0">
                    <children>
                        <Button fx:id="btnAdd" onAction="#handleAddBook" text="Agregar" />
                        <Button fx:id="btnClear" onAction="#handleClearFields" styleClass="button-danger" text="Limpiar" />
                    </children>
                </HBox>
            </children>
        </VBox>

        <TableView fx:id="tableBooks" prefHeight="350.0">
            <columns>
                <TableColumn fx:id="colBookId" text="ID" prefWidth="60" />
                <TableColumn fx:id="colIsbn" text="ISBN" prefWidth="150" />
                <TableColumn fx:id="colTitle" text="Titulo" prefWidth="200" />
                <TableColumn fx:id="colAuthor" text="Autor" prefWidth="150" />
                <TableColumn fx:id="colPublisher" text="Editorial" prefWidth="150" />
                <TableColumn fx:id="colYear" text="Anio" prefWidth="80" />
                <TableColumn fx:id="colTotalStock" text="Total" prefWidth="80" />
                <TableColumn fx:id="colAvailableStock" text="Disponibles" prefWidth="100" />
            </columns>
        </TableView>

        <HBox spacing="10.0">
            <children>
                <Button fx:id="btnNewBorrowing" onAction="#handleNewBorrowing" text="Nuevo Prestamo" />
                <Button fx:id="btnRequestBorrowing" onAction="#handleRequestBorrowing" text="Solicitar Prestamo" />
                <Button fx:id="btnBack" onAction="#handleBack" styleClass="button-back" text="Regresar" />
            </children>
        </HBox>
    </children>
</VBox>